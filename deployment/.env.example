# =============================================================
#  Banking AI Copilot — Environment Variables Template
#  Copy this file to .env and fill in your actual values
#  NEVER commit .env to version control
# =============================================================

# --- LLM Provider ---
# Options: groq (default, fast + free tier) | openai
LLM_PROVIDER=groq

# Groq — https://console.groq.com/keys
# Best model: llama-3.3-70b-versatile (128K ctx, fastest 70B on market)
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM API Keys ---
OPENAI_API_KEY=sk-your-openai-key-here
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=banking-index

# --- Database ---
DATABASE_URL=sqlite:///./banking.db

# --- RAG Configuration ---
EMBEDDING_BACKEND=sentence_transformers
VECTOR_DB=chroma
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION=banking_docs
LLM_MODEL=llama-3.3-70b-versatile

# --- Security ---
# Comma-separated list of allowed origins.  Use * for local dev only.
# Production example: CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=*

# JWT Authentication
# CRITICAL: Replace with a strong 256-bit random key in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-256-bit-random-key
JWT_EXPIRE_MINUTES=480

# Rate Limiting (requests per minute per IP)
RATE_LIMIT=60/minute

# Deployment environment (development or production)
ENVIRONMENT=development

# --- LLM Model Routing (override defaults) ---
MODEL_SUMMARIZATION=gpt-4
MODEL_FRAUD=gpt-4
MODEL_COMPLIANCE=gpt-4
MODEL_SENSITIVE=gpt-3.5-turbo
MODEL_LOOKUP=gpt-3.5-turbo
MODEL_SENTIMENT=gpt-3.5-turbo
MODEL_GENERAL=gpt-4

# --- Grafana (docker-compose) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

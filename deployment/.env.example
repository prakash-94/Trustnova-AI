# =============================================================
#  Banking AI Copilot — Environment Variables Template
#  Copy this file to .env and fill in your actual values
#  NEVER commit .env to version control
# =============================================================

# --- LLM API Keys ---
OPENAI_API_KEY=sk-your-openai-key-here
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=banking-index

# --- Database ---
DATABASE_URL=sqlite:///./banking.db

# --- RAG Configuration ---
EMBEDDING_BACKEND=sentence_transformers
VECTOR_DB=chroma
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION=banking_docs
LLM_MODEL=gpt-4

# --- Security (CORS) ---
# Comma-separated list of allowed origins.  Use * for local dev only.
# Production example: CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=*

# --- LLM Model Routing (override defaults) ---
MODEL_SUMMARIZATION=gpt-4
MODEL_FRAUD=gpt-4
MODEL_COMPLIANCE=gpt-4
MODEL_SENSITIVE=gpt-3.5-turbo
MODEL_LOOKUP=gpt-3.5-turbo
MODEL_SENTIMENT=gpt-3.5-turbo
MODEL_GENERAL=gpt-4

# --- Grafana (docker-compose) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# =============================================================
#  Banking AI Copilot — Frontend (Nginx)
#  Serves static dashboard and proxies API requests to backend
# =============================================================
FROM nginx:1.25-alpine

# Remove default nginx config & content
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf

# Copy frontend static files
COPY frontend/ /usr/share/nginx/html/

# Create /static/css and /static/js directories matching the HTML asset paths
# (HTML references /static/css/dashboard.css and /static/js/*.js
#  because FastAPI mounts the frontend dir at /static in local dev)
RUN mkdir -p /usr/share/nginx/html/static && \
    cp -r /usr/share/nginx/html/css /usr/share/nginx/html/static/css && \
    cp -r /usr/share/nginx/html/js /usr/share/nginx/html/static/js

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

# =============================================================
#  Banking AI Copilot — Backend (FastAPI)
#  Multi-stage build for a slim production image
# =============================================================
FROM python:3.11-slim AS base

# Prevent Python from buffering stdout/stderr (real-time logs)
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# System deps for XGBoost, scikit-learn, and ChromaDB native libs
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libgomp1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# ── Install Python dependencies ──────────────────────────────
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ── Copy application source ─────────────────────────────────
COPY src/ ./src/
COPY models/ ./models/
COPY data/ ./data/
COPY banking.db ./banking.db

# ── Expose & Run ─────────────────────────────────────────────
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]

# =============================================================
#  TrustNova AI — Backend (FastAPI + RAG)
#  Multi-stage build → slim production image
#  Docker Hub: chotu94/trusnova-backend
# =============================================================

FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# ── System dependencies ──────────────────────────────────────
# libgomp1  → XGBoost / LightGBM OpenMP runtime
# curl      → health-check probe
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libgomp1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ──────────────────────────────────────
# Install CPU-only PyTorch first to avoid pulling 3 GB of CUDA packages.
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install -r requirements.txt

# ── Application source ───────────────────────────────────────
COPY src/ ./src/

# ── Policy documents (needed by RAG at startup) ──────────────
COPY data/raw/banking_docs/ ./data/raw/banking_docs/

# ── Pre-seeded database (generated by ETL pipeline locally) ──
# Build with: python -m src.data.etl_pipeline  (generates banking.db)
# If the file is absent at build time, entrypoint.sh regenerates it
# on first container start (~90 s, one-time cost).
RUN mkdir -p /app/data
COPY banking.db /app/data/banking.db

# ── Entrypoint (DB init + server launch) ─────────────────────
COPY deployment/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# ── Non-root user for security ───────────────────────────────
RUN useradd -m -u 1001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
    CMD curl -f http://localhost:8001/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]

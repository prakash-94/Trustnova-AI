# ═══════════════════════════════════════════════════════════════════
#  TrustNova AI — .gitignore
#  Rule: only source code, config templates, and docs go to GitHub.
#  Secrets, generated binaries, and local tooling stay local.
# ═══════════════════════════════════════════════════════════════════

# ── Secrets & Credentials ───────────────────────────────────────────
# NEVER commit real credentials — use deployment/.env.example as the
# template and fill in values locally or via CI secrets.
.env
.env.*
!.env.example
*.key
*.pem
*.secret
secrets/
.secrets
credentials.json

# ── Python Runtime ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
venv/
.venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── ML Models & Serialised Binaries ─────────────────────────────────
# Pickle / joblib / HuggingFace / PyTorch / ONNX files are large
# binary artefacts generated by training scripts.  Regenerate locally
# with: python -m src.models.train  (or the relevant training script)
/models/
*.pkl
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.safetensors
mlruns/

# ── Databases & Vector Stores ───────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/chroma_db/
data/raw/*
!data/raw/.gitkeep
!data/raw/banking_docs/
!data/raw/banking_docs/*
data/processed/*
!data/processed/.gitkeep
data/embeddings/*
!data/embeddings/.gitkeep

# ── Generated Reports & Media ───────────────────────────────────────
# Charts, dashboards, and images produced by notebooks or scripts.
reports/

# ── Office / Binary Documents ───────────────────────────────────────
# Keep design docs in Notion/Confluence, not the repo.
*.docx
*.xlsx
*.pptx
*.pdf

# ── Local Development Scripts ───────────────────────────────────────
# One-off migration/seed/setup scripts that only make sense locally
# and may contain hardcoded local paths or dev credentials.
scripts/

# ── Legacy / Prototype Frontend ─────────────────────────────────────
# The original Streamlit/static HTML prototype (pre-React).
# Production frontend lives in frontend-react/.
frontend/

# ── Node / React / Vite ─────────────────────────────────────────────
frontend-react/node_modules/
frontend-react/dist/
frontend-react/.vite/
frontend-react/.env
frontend-react/.env.*
frontend-react/*.local

# ── Docker Runtime Volumes ──────────────────────────────────────────
deployment/grafana-data/
deployment/prometheus-data/

# ── Logs ────────────────────────────────────────────────────────────
*.log
*.log.*
logs/
backend*.log
frontend_vite.log

# ── IDEs & Editors ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS Artefacts ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
ehthumbs.db
